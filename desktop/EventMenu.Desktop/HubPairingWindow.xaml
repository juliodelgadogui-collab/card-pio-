<Window x:Class="EventMenu.Desktop.HubPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectar celular • EventMenu" Width="560" Height="660" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Conectar celular" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Abra o EventMenu no celular e leia o código abaixo." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,20,0,18">
            <StackPanel VerticalAlignment="Center">
                <Border Width="252" Height="252" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12" HorizontalAlignment="Center">
                    <Image x:Name="PairingQrImage" Stretch="Uniform" />
                </Border>

                <TextBlock Text="Aponte a câmera do celular para o QR Code" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock x:Name="ExpiresText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20" />

                <TextBlock Text="Se preferir, use o código" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="20,10,20,10">
                    <TextBlock x:Name="PairingCodeText" HorizontalAlignment="Center" TextAlignment="Center"
                               FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <Button Content="Copiar código" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Click="CopyButton_Click" />

                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                    <TextBlock Text="Esse código é temporário e funciona apenas uma vez." Foreground="#475569" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Text="Mantenha esta janela aberta enquanto faz a conexão." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>
