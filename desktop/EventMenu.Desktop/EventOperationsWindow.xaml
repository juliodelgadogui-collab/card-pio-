<Window x:Class="EventMenu.Desktop.EventOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eventos • EventMenu" Width="1220" Height="820" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Operação de eventos" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Acesso, convidados, bar, retirada e acompanhamento do evento." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="EVENTO" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="EventSelector" Grid.Column="1" Height="42" VerticalContentAlignment="Center" SelectionChanged="EventSelector_SelectionChanged"/>
                <TextBlock x:Name="EventSummaryText" Grid.Column="2" Margin="16,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="EventRevenueText" Grid.Column="3" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="EventTabs">
            <TabItem Header="Visão geral">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Ingressos pagos" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="TicketsPaidText" Text="—" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="TicketsCheckinText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Convidados" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="GuestsText" Text="—" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="GuestsPendingText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Receita ingressos" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="TicketRevenueText" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="Receita bar" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BarRevenueText" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                    <Border x:Name="RecentEntriesCard" Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Entradas recentes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" x:Name="RecentEntriesGrid" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TypeDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="Pessoa" Binding="{Binding PersonName}" Width="210"/>
                                    <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*"/>
                                    <DataGridTextColumn Header="Operador" Binding="{Binding OperatorName}" Width="170"/>
                                    <DataGridTextColumn Header="Horário" Binding="{Binding CheckedInDisplay}" Width="155"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Entrada" x:Name="AccessTab">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20" x:Name="TicketPanel">
                        <StackPanel>
                            <TextBlock Text="Check-in de ingresso" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Leia ou cole o código do ingresso. O servidor impede check-in duplicado." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,16" TextWrapping="Wrap"/>
                            <TextBox x:Name="TicketCodeBox" Height="44" VerticalContentAlignment="Center" MaxLength="500"/>
                            <Button x:Name="TicketCheckinButton" Content="Confirmar ingresso" Margin="0,12,0,0" Click="TicketCheckinButton_Click"/>
                            <TextBlock x:Name="TicketResultText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" x:Name="GuestPanel">
                        <StackPanel>
                            <TextBlock Text="Check-in de convidado" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Leia ou digite o código da lista de convidados." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,16" TextWrapping="Wrap"/>
                            <TextBox x:Name="GuestCodeBox" Height="44" VerticalContentAlignment="Center" MaxLength="500"/>
                            <Button x:Name="GuestCheckinButton" Content="Confirmar convidado" Margin="0,12,0,0" Click="GuestCheckinButton_Click"/>
                            <TextBlock x:Name="GuestResultText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Retirada do bar" x:Name="PickupTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PickupCodeBox" Height="44" VerticalContentAlignment="Center" MaxLength="500" ToolTip="QR ou código do pedido"/>
                            <Button Grid.Column="1" Content="Localizar pedido" Margin="12,0,0,0" Click="ResolvePickupButton_Click"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PickupTitleText" Text="Nenhum pedido lido" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PickupStateText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="PickupItemsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="90"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="PickupHintText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="DeliverPickupButton" Content="Confirmar entrega" HorizontalAlignment="Right" IsEnabled="False" Click="DeliverPickupButton_Click" Margin="0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Venda no bar" x:Name="BarSaleTab">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBox x:Name="BarSearchBox" Height="42" VerticalContentAlignment="Center" TextChanged="BarSearchBox_TextChanged" ToolTip="Buscar produto"/>
                            <DataGrid Grid.Row="1" x:Name="BarProductsGrid" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False" MouseDoubleClick="BarProductsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Estoque" Binding="{Binding StockDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="Preço" Binding="{Binding PriceDisplay}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Pedido do bar" FontSize="20" FontWeight="SemiBold"/>
                            <DataGrid Grid.Row="1" x:Name="BarCartGrid" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="65"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBox x:Name="BarNotesBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" ToolTip="Observações"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+" Width="42" Style="{StaticResource SecondaryButton}" Click="IncreaseBarItemButton_Click"/>
                                    <Button Content="−" Width="42" Style="{StaticResource SecondaryButton}" Click="DecreaseBarItemButton_Click"/>
                                    <Button Content="Remover" Style="{StaticResource SecondaryButton}" Click="RemoveBarItemButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <TextBlock x:Name="BarTotalText" Text="R$ 0,00" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="CreateBarOrderButton" Content="Criar pedido" HorizontalAlignment="Right" Click="CreateBarOrderButton_Click" Margin="0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="860"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
