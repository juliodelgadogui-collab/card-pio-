<Window x:Class="EventMenu.Desktop.TabPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conta da mesa • EventMenu" Width="980" Height="740" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" Text="Conta da mesa" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Text="Carregando a comanda..." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="TOTAL DA COMANDA" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="TotalText" Text="—" FontSize="23" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="JÁ PAGO" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="PaidText" Text="—" FontSize="23" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="FALTA PAGAR" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="RemainingText" Text="—" FontSize="23" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Como deseja receber?" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Escolha como dividir a conta. O valor da cobrança é calculado automaticamente." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18" />

                        <Button x:Name="ProductSplitButton" Content="Dividir por produtos" Style="{StaticResource SecondaryButton}" Click="ProductSplitButton_Click" Margin="0,0,0,16" ToolTip="Escolher produtos específicos desta comanda" />

                        <TextBlock Text="Ou dividir por" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SplitTypeCombo" Height="42" Margin="0,0,0,14" SelectionChanged="SplitTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Valor" Tag="value" />
                            <ComboBoxItem Content="Percentual" Tag="percentage" />
                            <ComboBoxItem Content="Pessoas" Tag="person" />
                        </ComboBox>

                        <TextBlock x:Name="SplitValueLabel" Text="Valor a receber" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SplitValueBox" Height="42" Margin="0,0,0,6" VerticalContentAlignment="Center" TextChanged="SplitValueBox_TextChanged" />
                        <TextBlock x:Name="SplitHintText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="Forma de pagamento" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PaymentMethodCombo" Height="42" Margin="0,0,0,14" SelectionChanged="PaymentMethodCombo_SelectionChanged" />

                        <StackPanel x:Name="PixCustomerPanel" Visibility="Collapsed">
                            <TextBlock Text="CPF ou CNPJ do pagador" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TaxIdBox" Height="42" Margin="0,0,0,14" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,2,0,16">
                            <TextBlock x:Name="PreviewText" Text="Escolha a divisão e a forma de pagamento." Foreground="#1E40AF" TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="ChargeButton" Content="Continuar" Height="44" Click="ChargeButton_Click" />
                        <Button x:Name="CancelGroupButton" Content="Cancelar cobrança iniciada" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="CancelGroupButton_Click" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Pagamento" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" x:Name="PaymentStateText" Text="Nenhuma cobrança iniciada." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14" TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="QrBorder" Visibility="Collapsed" HorizontalAlignment="Center" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                <Image x:Name="QrImage" Width="245" Height="245" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="PixCodeLabel" Text="PIX COPIA E COLA" Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
                            <TextBox x:Name="PixCodeBox" Height="88" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                            <Button x:Name="CopyPixButton" Content="Copiar código Pix" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="CopyPixButton_Click" Margin="0,10,0,0" />
                            <TextBlock x:Name="PixExpiryText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="ServerStatusText" Text="Aguardando pagamento." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>