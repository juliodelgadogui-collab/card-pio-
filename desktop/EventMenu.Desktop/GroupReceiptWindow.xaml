<Window x:Class="EventMenu.Desktop.GroupReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprovante da divisão • EventMenu" Width="900" Height="700" MinWidth="800" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Comprovante da divisão" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubtitleText" Text="Carregando..." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrintButton" Content="Imprimir" IsEnabled="False" Click="PrintButton_Click" Margin="0"/>
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="VALOR DESTA PARTE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="AmountText" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="FORMA" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="MethodText" Text="—" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="DIVISÃO" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SplitText" Text="—" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SITUAÇÃO" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="StateText" Text="—" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Produtos desta parte" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" x:Name="ItemsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="75"/>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Qtd." Binding="{Binding QuantityDisplay}" Width="65"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding AmountDisplay}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Distribuição entre pedidos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" x:Name="AllocationsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="90"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding AmountDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="LocationText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OperatorText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ConfirmedText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="COMPROVANTE NÃO FISCAL" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
