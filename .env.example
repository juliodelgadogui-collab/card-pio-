APP_NAME="EventMenu Premium"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio.com.br
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eventmenu
DB_USERNAME=eventmenu
DB_PASSWORD=

SESSION_NAME=eventmenu_session
SESSION_SECURE=true

PAYMENT_CURRENCY=BRL

# E-mail: use log durante testes, mail para a funcao mail() da hospedagem ou smtp em producao.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@seu-dominio.com.br
MAIL_FROM_NAME="EventMenu Premium"
MAIL_TIMEOUT=15
