<Window x:Class="EventMenu.Desktop.DeliveryWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minhas entregas • EventMenu" Width="1080" Height="760" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Minhas entregas" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Retire o pedido, inicie a rota, confirme a chegada, receba o pagamento quando necessário e conclua a entrega." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="HandoffButton" Content="Repassar dinheiro" Style="{StaticResource SecondaryButton}" Click="HandoffButton_Click"/>
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <DataGrid x:Name="DeliveryGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="DeliveryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="80"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Endereço" Binding="{Binding DeliveryAddress}" Width="*"/>
                        <DataGridTextColumn Header="Etapa" Binding="{Binding StageDisplay}" Width="135"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="OrderTitleText" Text="Selecione uma entrega" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CustomerText" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AddressText" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StageText" Margin="0,14,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Separator Margin="0,16"/>
                        <Button x:Name="PickupButton" Content="Retirar pedido" IsEnabled="False" Click="PickupButton_Click"/>
                        <Button x:Name="StartRouteButton" Content="Iniciar rota" IsEnabled="False" Click="StartRouteButton_Click"/>
                        <Button x:Name="ArriveButton" Content="Cheguei" IsEnabled="False" Click="ArriveButton_Click"/>
                        <Button x:Name="ReceivePixButton" Content="Receber por Pix" IsEnabled="False" Click="ReceivePixButton_Click"/>
                        <Button x:Name="ReceiveCashButton" Content="Receber em dinheiro" IsEnabled="False" Click="ReceiveCashButton_Click"/>
                        <Button x:Name="CompleteButton" Content="Concluir entrega" IsEnabled="False" Click="CompleteButton_Click"/>
                        <Button x:Name="TrackingButton" Content="Acompanhamento do cliente" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="TrackingButton_Click"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                            <TextBlock Text="A localização da entrega é enviada pelo celular do entregador quando o acompanhamento estiver ativo." Foreground="#1D4ED8" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="760"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>