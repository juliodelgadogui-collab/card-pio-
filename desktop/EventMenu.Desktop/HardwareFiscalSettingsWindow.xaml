<Window x:Class="EventMenu.Desktop.HardwareFiscalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu • Configurações" Width="980" Height="790"
        MinWidth="860" MinHeight="700" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="SettingsHeadingText" Text="Configurações" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="UnitText" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="390" />
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="SettingsTabs">
            <TabItem x:Name="HardwareTab" Header="Equipamentos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Equipamentos deste computador" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Escolha os equipamentos usados no atendimento e na impressão."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
                        <TextBlock Text="Impressora padrão" FontWeight="SemiBold" />
                        <TextBox x:Name="DefaultPrinterBox" Margin="0,5,0,12" />
                        <TextBlock Text="Impressora ligada à gaveta" FontWeight="SemiBold" />
                        <TextBox x:Name="CashDrawerBox" Margin="0,5,0,12" />
                        <TextBlock Text="Balança" FontWeight="SemiBold" />
                        <TextBox x:Name="ScaleBox" Margin="0,5,0,12" />
                        <TextBlock Text="Leitor de código de barras" FontWeight="SemiBold" />
                        <TextBox x:Name="BarcodeBox" Margin="0,5,0,12" />
                        <TextBlock Text="Tela do cliente" FontWeight="SemiBold" />
                        <TextBox x:Name="CustomerDisplayBox" Margin="0,5,0,12" />
                        <TextBlock Text="Maquininha de cartão" FontWeight="SemiBold" />
                        <TextBox x:Name="PinpadBox" Margin="0,5,0,5" />
                        <TextBlock Text="Se a maquininha exigir uma identificação local, informe aqui. Caso contrário, deixe em branco."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <Button x:Name="SaveHardwareButton" Content="Salvar equipamentos" Width="180" HorizontalAlignment="Left" Click="SaveHardwareButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TefTab" Header="Cartão">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Pagamento com cartão" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Configure a maquininha disponível neste computador. As opções técnicas ficam escondidas em Configurações avançadas."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                        <TextBlock Text="Maquininha configurada" FontWeight="SemiBold" />
                        <ComboBox x:Name="TerminalSelector" Margin="0,5,0,14" DisplayMemberPath="DisplayName" SelectionChanged="TerminalSelector_SelectionChanged" />
                        <Button Content="Adicionar maquininha" Width="160" HorizontalAlignment="Left" Margin="0,0,0,16" Click="NewTerminalButton_Click" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nome no caixa" FontWeight="SemiBold" /><TextBox x:Name="TerminalLabelBox" Margin="0,5,0,12" />
                                <TextBlock Text="Identificação da maquininha" FontWeight="SemiBold" /><TextBox x:Name="TerminalPinpadBox" Margin="0,5,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Funcionamento" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                                    <CheckBox x:Name="TerminalEnabledCheck" Content="Maquininha ativa" IsChecked="True" Margin="0,0,22,0" />
                                    <CheckBox x:Name="AutoCaptureCheck" Content="Confirmar automaticamente" IsChecked="True" />
                                </StackPanel>
                                <Expander Header="Configurações avançadas" Margin="0,4,0,0">
                                    <StackPanel Margin="12,10,0,4">
                                        <TextBlock Text="Altere estes campos apenas quando o suporte ou a empresa responsável pela maquininha orientar."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" />
                                        <TextBlock Text="Integração de pagamento" FontWeight="SemiBold" /><ComboBox x:Name="ProviderCombo" Margin="0,5,0,12" />
                                        <TextBlock Text="Tipo de integração" FontWeight="SemiBold" /><ComboBox x:Name="IntegrationModeCombo" Margin="0,5,0,12" />
                                        <TextBlock Text="Endereço do serviço local" FontWeight="SemiBold" />
                                        <TextBox x:Name="BridgeUrlBox" Margin="0,5,0,12" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="SaveTerminalButton" Content="Salvar maquininha" Width="160" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SaveTerminalButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FiscalTab" Header="Nota fiscal">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Emissão de nota fiscal" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Preencha os dados da empresa, certificado e tributação dos produtos. Comece no ambiente de testes antes de usar em produção."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <CheckBox x:Name="FiscalEnabledCheck" Content="Emitir nota fiscal nesta unidade" Margin="0,0,22,0" />
                            <CheckBox x:Name="ContingencyCheck" Content="Permitir emissão em contingência" />
                        </StackPanel>

                        <TextBlock Text="Dados da empresa" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ambiente" FontWeight="SemiBold" /><ComboBox x:Name="FiscalEnvironmentCombo" Margin="0,5,0,12" />
                                <TextBlock Text="Tipo de nota padrão" FontWeight="SemiBold" /><ComboBox x:Name="DefaultDocumentCombo" Margin="0,5,0,12" />
                                <TextBlock Text="Razão social" FontWeight="SemiBold" /><TextBox x:Name="LegalNameBox" Margin="0,5,0,12" />
                                <TextBlock Text="Nome fantasia" FontWeight="SemiBold" /><TextBox x:Name="TradeNameBox" Margin="0,5,0,12" />
                                <TextBlock Text="CNPJ" FontWeight="SemiBold" /><TextBox x:Name="CnpjBox" Margin="0,5,0,12" />
                                <TextBlock Text="Inscrição estadual" FontWeight="SemiBold" /><TextBox x:Name="IeBox" Margin="0,5,0,12" />
                                <TextBlock Text="Inscrição municipal (opcional)" FontWeight="SemiBold" /><TextBox x:Name="MunicipalRegistrationBox" Margin="0,5,0,12" />
                                <TextBlock Text="CNAE (opcional)" FontWeight="SemiBold" /><TextBox x:Name="CnaeBox" Margin="0,5,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="UF" FontWeight="SemiBold" /><TextBox x:Name="UfBox" MaxLength="2" Margin="0,5,0,12" />
                                <TextBlock Text="Regime tributário" FontWeight="SemiBold" /><TextBox x:Name="TaxRegimeBox" Margin="0,5,0,12" />
                                <TextBlock Text="Telefone (opcional)" FontWeight="SemiBold" /><TextBox x:Name="FiscalPhoneBox" Margin="0,5,0,12" />
                                <TextBlock Text="E-mail fiscal (opcional)" FontWeight="SemiBold" /><TextBox x:Name="FiscalEmailBox" Margin="0,5,0,12" />
                                <TextBlock Text="País" FontWeight="SemiBold" /><TextBox x:Name="CountryNameBox" Margin="0,5,0,12" Text="Brasil" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,16" />
                        <TextBlock Text="Endereço da empresa" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Logradouro" FontWeight="SemiBold"/><TextBox x:Name="StreetBox" Margin="0,5,0,12"/>
                                <TextBlock Text="Bairro" FontWeight="SemiBold"/><TextBox x:Name="DistrictBox" Margin="0,5,0,12"/>
                                <TextBlock Text="Cidade" FontWeight="SemiBold"/><TextBox x:Name="CityNameBox" Margin="0,5,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Número" FontWeight="SemiBold"/><TextBox x:Name="AddressNumberBox" Margin="0,5,0,12"/>
                                <TextBlock Text="Complemento (opcional)" FontWeight="SemiBold"/><TextBox x:Name="AddressComplementBox" Margin="0,5,0,12"/>
                                <TextBlock Text="CEP" FontWeight="SemiBold"/><TextBox x:Name="PostalCodeBox" MaxLength="9" Margin="0,5,0,12"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,16" />
                        <TextBlock Text="Numeração e certificado" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Série NFC-e" FontWeight="SemiBold" /><TextBox x:Name="NfceSeriesBox" Margin="0,5,0,12" />
                                <TextBlock Text="Série NF-e" FontWeight="SemiBold" /><TextBox x:Name="NfeSeriesBox" Margin="0,5,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Local do certificado" FontWeight="SemiBold" /><ComboBox x:Name="CertificateModeCombo" Margin="0,5,0,12" />
                            </StackPanel>
                        </Grid>

                        <Expander Header="Configurações fiscais avançadas" Margin="0,8,0,10">
                            <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Estes dados normalmente são informados pelo contador ou pela configuração fiscal da empresa."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" />
                                        <TextBlock Text="Código oficial do município (IBGE)" FontWeight="SemiBold" /><TextBox x:Name="CityCodeBox" Margin="0,5,0,12" />
                                        <TextBlock Text="Código do país" FontWeight="SemiBold" /><TextBox x:Name="CountryCodeBox" Margin="0,5,0,12" Text="1058" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CSC ID" FontWeight="SemiBold" /><TextBox x:Name="CscIdBox" Margin="0,5,0,12" />
                                        <TextBlock Text="Novo CSC (opcional)" FontWeight="SemiBold" /><PasswordBox x:Name="CscTokenBox" Margin="0,5,0,12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Expander>

                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="SaveFiscalButton" Content="Salvar configuração" Width="180" Click="SaveFiscalButton_Click" />
                            <Button x:Name="ProductTaxButton" Content="Tributação dos produtos" Width="190" Click="ProductTaxButton_Click" />
                            <Button x:Name="CheckFiscalButton" Content="Verificar configuração" Width="175" Click="CheckFiscalButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="FiscalReadinessText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22" />
                        <TextBlock Text="Certificado digital A1" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="CertificateStatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="SelectCertificateButton" Content="Escolher certificado" Width="155" DockPanel.Dock="Left" Click="SelectCertificateButton_Click" />
                            <TextBlock x:Name="CertificateFileText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="Senha do certificado" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <PasswordBox x:Name="CertificatePasswordBox" Margin="0,5,0,12" />
                        <Button x:Name="ImportCertificateButton" Content="Importar certificado" Width="180" HorizontalAlignment="Left" Click="ImportCertificateButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="As configurações ficam salvas para esta unidade." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </DockPanel>
    </Grid>
</Window>