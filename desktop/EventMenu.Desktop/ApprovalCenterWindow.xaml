<Window x:Class="EventMenu.Desktop.ApprovalCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aprovações • EventMenu" Width="1060" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Aprovações" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Descontos e cancelamentos que precisam de decisão." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="ApprovalTabs">
            <TabItem x:Name="DiscountTab" Header="Descontos">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="DiscountGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DiscountGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="80" />
                            <DataGridTextColumn Header="Solicitante" Binding="{Binding RequesterName}" Width="160" />
                            <DataGridTextColumn Header="Desconto" Binding="{Binding RequestedDisplay}" Width="110" />
                            <DataGridTextColumn Header="Total atual" Binding="{Binding TotalDisplay}" Width="110" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="Solicitado em" Binding="{Binding CreatedDisplay}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DiscountSelectionText" Text="Selecione uma solicitação de desconto." FontWeight="SemiBold" />
                                <TextBlock Text="A aprovação só será concluída se o pedido continuar elegível no servidor." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBox x:Name="DiscountRejectReasonBox" Grid.Column="1" Height="40" Margin="14,0"
                                     VerticalContentAlignment="Center" ToolTip="Motivo da recusa" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ApproveDiscountButton" Content="Aprovar" Click="ApproveDiscountButton_Click" IsEnabled="False" />
                                <Button x:Name="RejectDiscountButton" Content="Recusar" Style="{StaticResource SecondaryButton}" Click="RejectDiscountButton_Click" IsEnabled="False" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CancellationTab" Header="Cancelamentos">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="CancellationGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CancellationGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="80" />
                            <DataGridTextColumn Header="Solicitante" Binding="{Binding RequesterName}" Width="160" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerDisplay}" Width="180" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="110" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="Solicitado em" Binding="{Binding CreatedDisplay}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CancellationSelectionText" Text="Selecione uma solicitação de cancelamento." FontWeight="SemiBold" />
                                <TextBlock Text="Pedidos pagos ou com cobrança ativa continuam protegidos pelas regras do servidor." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBox x:Name="CancellationRejectReasonBox" Grid.Column="1" Height="40" Margin="14,0"
                                     VerticalContentAlignment="Center" ToolTip="Motivo da recusa" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ApproveCancellationButton" Content="Aprovar" Click="ApproveCancellationButton_Click" IsEnabled="False" />
                                <Button x:Name="RejectCancellationButton" Content="Recusar" Style="{StaticResource SecondaryButton}" Click="RejectCancellationButton_Click" IsEnabled="False" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>