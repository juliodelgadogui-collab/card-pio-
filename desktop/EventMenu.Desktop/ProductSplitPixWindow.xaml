<Window x:Class="EventMenu.Desktop.ProductSplitPixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pix da comanda • EventMenu" Width="620" Height="680" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Pagamento por Pix" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="AmountText" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,16,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border HorizontalAlignment="Center" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <Image x:Name="QrImage" Width="300" Height="300" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="PIX COPIA E COLA" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                    <TextBox x:Name="PixCodeBox" Height="92" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Copiar código Pix" Style="{StaticResource SecondaryButton}" Click="CopyButton_Click" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ExpiryText" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="StatusText" Text="Aguardando pagamento..." Foreground="#1D4ED8" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Button Content="Verificar agora" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="CheckButton_Click" Margin="0"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>