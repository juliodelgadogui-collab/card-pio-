<Window x:Class="EventMenu.Desktop.HardwareFiscalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu • Equipamentos e Fiscal" Width="920" Height="760"
        MinWidth="820" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Equipamentos e Fiscal" FontSize="27" FontWeight="SemiBold" />
                <TextBlock x:Name="UnitText" Foreground="#667085" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#667085" TextWrapping="Wrap" MaxWidth="360" />
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="SettingsTabs">
            <TabItem x:Name="HardwareTab" Header="Equipamentos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Hardware deste computador" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Os nomes abaixo identificam os equipamentos que o EventMenu Hub pode usar neste Windows."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,18" />

                        <TextBlock Text="Impressora padrão" FontWeight="SemiBold" />
                        <TextBox x:Name="DefaultPrinterBox" Margin="0,5,0,12" ToolTip="Use exatamente o nome da impressora instalada no Windows." />
                        <TextBlock Text="Impressora ligada à gaveta" FontWeight="SemiBold" />
                        <TextBox x:Name="CashDrawerBox" Margin="0,5,0,12" ToolTip="Em impressoras ESC/POS, o EventMenu envia o pulso de abertura da gaveta." />
                        <TextBlock Text="Balança" FontWeight="SemiBold" />
                        <TextBox x:Name="ScaleBox" Margin="0,5,0,12" ToolTip="Nome/porta da balança. O driver específico poderá usar este identificador." />
                        <TextBlock Text="Leitor de código de barras" FontWeight="SemiBold" />
                        <TextBox x:Name="BarcodeBox" Margin="0,5,0,12" />
                        <TextBlock Text="Segundo monitor / tela do cliente" FontWeight="SemiBold" />
                        <TextBox x:Name="CustomerDisplayBox" Margin="0,5,0,12" />
                        <TextBlock Text="PINPad físico deste computador" FontWeight="SemiBold" />
                        <TextBox x:Name="PinpadBox" Margin="0,5,0,18" />

                        <Button x:Name="SaveHardwareButton" Content="Salvar equipamentos" Width="180" HorizontalAlignment="Left" Click="SaveHardwareButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TefTab" Header="TEF / PINPad">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Integração com maquininha / PINPad" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="O EventMenu usa uma intenção segura no servidor e chama o conector homologado instalado neste computador. Aprovação local nunca confirma o pedido sozinha."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,16" />

                        <TextBlock Text="Terminal existente" FontWeight="SemiBold" />
                        <ComboBox x:Name="TerminalSelector" Margin="0,5,0,14" DisplayMemberPath="DisplayName" SelectionChanged="TerminalSelector_SelectionChanged" />
                        <Button Content="Novo terminal" Width="130" HorizontalAlignment="Left" Margin="0,0,0,16" Click="NewTerminalButton_Click" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Provedor" FontWeight="SemiBold" />
                                <ComboBox x:Name="ProviderCombo" Margin="0,5,0,12" />
                                <TextBlock Text="Nome no caixa" FontWeight="SemiBold" />
                                <TextBox x:Name="TerminalLabelBox" Margin="0,5,0,12" />
                                <TextBlock Text="Identificação do PINPad" FontWeight="SemiBold" />
                                <TextBox x:Name="TerminalPinpadBox" Margin="0,5,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Modo" FontWeight="SemiBold" />
                                <ComboBox x:Name="IntegrationModeCombo" Margin="0,5,0,12" />
                                <TextBlock Text="Conector local" FontWeight="SemiBold" />
                                <TextBox x:Name="BridgeUrlBox" Margin="0,5,0,12" ToolTip="Ex.: http://127.0.0.1:18765/. Somente localhost é aceito pelo Desktop." />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <CheckBox x:Name="TerminalEnabledCheck" Content="Ativo" IsChecked="True" Margin="0,0,22,0" />
                                    <CheckBox x:Name="AutoCaptureCheck" Content="Captura automática" IsChecked="True" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,14,0,14">
                            <TextBlock Text="PagBank, Stone e SiTef podem usar esta mesma interface quando o conector/SDK homologado correspondente estiver instalado. Segredos da adquirente não são mostrados aqui."
                                       Foreground="#475467" TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="SaveTerminalButton" Content="Salvar terminal" Width="160" HorizontalAlignment="Left" Click="SaveTerminalButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FiscalTab" Header="NFC-e / NF-e">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Configuração fiscal da unidade" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Configure primeiro em homologação. O certificado não é exibido nem pode ser baixado depois da importação."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,16" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <CheckBox x:Name="FiscalEnabledCheck" Content="Fiscal ativo" Margin="0,0,22,0" />
                            <CheckBox x:Name="ContingencyCheck" Content="Permitir contingência local" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ambiente" FontWeight="SemiBold" /><ComboBox x:Name="FiscalEnvironmentCombo" Margin="0,5,0,12" />
                                <TextBlock Text="Documento padrão" FontWeight="SemiBold" /><ComboBox x:Name="DefaultDocumentCombo" Margin="0,5,0,12" />
                                <TextBlock Text="Razão social" FontWeight="SemiBold" /><TextBox x:Name="LegalNameBox" Margin="0,5,0,12" />
                                <TextBlock Text="Nome fantasia" FontWeight="SemiBold" /><TextBox x:Name="TradeNameBox" Margin="0,5,0,12" />
                                <TextBlock Text="CNPJ" FontWeight="SemiBold" /><TextBox x:Name="CnpjBox" Margin="0,5,0,12" />
                                <TextBlock Text="Inscrição estadual" FontWeight="SemiBold" /><TextBox x:Name="IeBox" Margin="0,5,0,12" />
                                <TextBlock Text="UF" FontWeight="SemiBold" /><TextBox x:Name="UfBox" MaxLength="2" Margin="0,5,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Código IBGE do município" FontWeight="SemiBold" /><TextBox x:Name="CityCodeBox" Margin="0,5,0,12" />
                                <TextBlock Text="Regime tributário" FontWeight="SemiBold" /><TextBox x:Name="TaxRegimeBox" Margin="0,5,0,12" ToolTip="Código usado pela configuração fiscal da empresa." />
                                <TextBlock Text="Série NFC-e" FontWeight="SemiBold" /><TextBox x:Name="NfceSeriesBox" Margin="0,5,0,12" />
                                <TextBlock Text="Série NF-e" FontWeight="SemiBold" /><TextBox x:Name="NfeSeriesBox" Margin="0,5,0,12" />
                                <TextBlock Text="CSC ID" FontWeight="SemiBold" /><TextBox x:Name="CscIdBox" Margin="0,5,0,12" />
                                <TextBlock Text="Novo CSC (opcional)" FontWeight="SemiBold" /><PasswordBox x:Name="CscTokenBox" Margin="0,5,0,12" ToolTip="Deixe vazio para manter o CSC já salvo." />
                                <TextBlock Text="Onde usar o certificado" FontWeight="SemiBold" /><ComboBox x:Name="CertificateModeCombo" Margin="0,5,0,12" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="SaveFiscalButton" Content="Salvar configuração fiscal" Width="205" HorizontalAlignment="Left" Click="SaveFiscalButton_Click" />

                        <Border Height="1" Background="#EAECF0" Margin="0,22" />
                        <TextBlock Text="Certificado digital A1" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="CertificateStatusText" Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="SelectCertificateButton" Content="Escolher PFX/P12" Width="145" DockPanel.Dock="Left" Click="SelectCertificateButton_Click" />
                            <TextBlock x:Name="CertificateFileText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#667085" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="Senha do certificado" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <PasswordBox x:Name="CertificatePasswordBox" Margin="0,5,0,12" />
                        <Button x:Name="ImportCertificateButton" Content="Importar certificado" Width="180" HorizontalAlignment="Left" Click="ImportCertificateButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Alterações são vinculadas à unidade e auditadas pelo servidor." Foreground="#667085" VerticalAlignment="Center" />
            <Button Content="Fechar" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
