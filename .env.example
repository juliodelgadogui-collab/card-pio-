APP_NAME="EventMenu Premium"
APP_ENV=production
APP_DEBUG=false
# Domínio oficial da instalação EventMenu.
APP_URL=https://go.gestao2.store
# Backend e APIs do EventMenu GO instalados em https://go.gestao2.store/1/
APP_BASE_PATH=/1
APP_KEY=change-me-with-a-long-random-secret
# Segredo longo para chamar cron.php via HTTP usando o cabeçalho X-Cron-Secret
CRON_SECRET=change-me-with-another-long-random-secret

# Primeira instalação: SQLite. Pode ser migrado para MySQL/MariaDB depois.
DB_CONNECTION=sqlite

# SQLite
DB_SQLITE_PATH=storage/eventmenu.sqlite

# MySQL/MariaDB (usado somente quando DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eventmenu
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=eventmenu_session
SESSION_SECURE=true

PAYMENT_CURRENCY=BRL
STRIPE_WEBHOOK_SECRET=
PAGBANK_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# SumUp Tap-to-Pay / OAuth multiempresa.
# CLIENT_SECRET fica SOMENTE no servidor e nunca deve ser inserido no APK.
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_AFFILIATE_KEY=
SUMUP_APP_ID=br.com.eventmenu.go

# As credenciais abaixo NÃO pertencem ao servidor PHP. Elas são usadas somente
# no ambiente que compila o Android para baixar o SDK privado da SumUp:
# SUMUP_MAVEN_USERNAME
# SUMUP_MAVEN_PASSWORD
