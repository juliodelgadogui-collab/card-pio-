<Window x:Class="EventMenu.Desktop.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido • EventMenu" Width="1040" Height="780" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" Text="Pedido" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Text="Carregando informações..." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="TotalText" Text="—" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ANDAMENTO" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="StatusText" Text="—" FontSize="17" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PAGAMENTO" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="PaymentText" Text="—" FontSize="17" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CANAL" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ChannelText" Text="—" FontSize="17" FontWeight="SemiBold" /></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="Itens">
                        <DataGrid x:Name="ItemsGrid" Margin="0,10,0,0" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="70" />
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="110" />
                                <DataGridTextColumn Header="Observação" Binding="{Binding Notes}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Histórico">
                        <DataGrid x:Name="TimelineGrid" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Horário" Binding="{Binding CreatedDisplay}" Width="155" />
                                <DataGridTextColumn Header="Alteração" Binding="{Binding TransitionDisplay}" Width="180" />
                                <DataGridTextColumn Header="Operador" Binding="{Binding UserName}" Width="160" />
                                <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="120" />
                                <DataGridTextColumn Header="Observação" Binding="{Binding Notes}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cliente" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="CustomerText" Text="—" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="PhoneText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="LocationText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LoyaltyCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Fidelidade" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="LoyaltyBalanceText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10" TextWrapping="Wrap" />
                            <TextBlock x:Name="LoyaltyReservationText" Text="" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <Grid x:Name="LoyaltyActionPanel">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LoyaltyPointsBox" Height="40" VerticalContentAlignment="Center" ToolTip="Pontos a usar" />
                                <Button x:Name="ApplyLoyaltyButton" Grid.Column="1" Content="Usar pontos" Margin="10,0,0,0" Click="ApplyLoyaltyButton_Click" />
                            </Grid>
                            <Button x:Name="RemoveLoyaltyButton" Content="Remover pontos reservados" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="RemoveLoyaltyButton_Click" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DeliveryCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Entrega" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentDeliveryText" Text="Sem entregador" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap" />
                            <StackPanel x:Name="DeliveryAssignmentPanel" Visibility="Collapsed">
                                <TextBlock Text="Entregador" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DeliverySelector" Height="40" Margin="0,0,0,10" />
                                <Button x:Name="AssignDeliveryButton" Content="Salvar entregador" Click="AssignDeliveryButton_Click" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Observações" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="NotesText" Text="Nenhuma observação." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,12,0">
                <Button x:Name="AcceptOrderButton" Content="Aceitar pedido" Visibility="Collapsed" Click="AcceptOrderButton_Click" />
                <Button x:Name="ReceiptButton" Content="Comprovante" Style="{StaticResource SecondaryButton}" Click="ReceiptButton_Click" />
                <Button x:Name="DiscountRequestButton" Content="Solicitar desconto" Style="{StaticResource SecondaryButton}" Click="DiscountRequestButton_Click" Visibility="Collapsed" />
                <Button x:Name="CancellationRequestButton" Content="Solicitar cancelamento" Style="{StaticResource SecondaryButton}" Click="CancellationRequestButton_Click" Visibility="Collapsed" Margin="0" />
            </StackPanel>
            <Button Grid.Column="2" Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>