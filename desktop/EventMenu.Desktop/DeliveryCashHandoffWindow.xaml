<Window x:Class="EventMenu.Desktop.DeliveryCashHandoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repasse ao caixa • EventMenu" Width="760" Height="680"
        MinWidth="700" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Repasse ao caixa" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Entregue ao caixa o dinheiro recebido nas entregas e peça a confirmação pelo QR Code." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="RECEBIDO" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CollectedText" Text="R$ 0,00" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="JÁ REPASSADO" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ConfirmedText" Text="R$ 0,00" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="A ENTREGAR" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="OutstandingText" Text="R$ 0,00" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Como funciona" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="1. Gere o QR Code do valor pendente.&#10;2. Entregue o dinheiro ao caixa.&#10;3. O caixa lê o código e confirma o recebimento.&#10;4. Atualize esta tela para conferir se o repasse foi concluído."
                               Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,18" TextWrapping="Wrap" LineHeight="24"/>
                    <Button x:Name="CreateQrButton" Content="Gerar QR para o caixa" IsEnabled="False" Click="CreateQrButton_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="HandoffStatusText" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </StackPanel>

                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="QrImage" Width="290" Height="290" Stretch="Uniform"/>
                        <TextBlock x:Name="QrAmountText" Text="Nenhum QR gerado" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock x:Name="QrHintText" Text="O QR aparecerá aqui." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="290"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
