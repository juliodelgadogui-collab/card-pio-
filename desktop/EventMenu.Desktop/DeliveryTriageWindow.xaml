<Window x:Class="EventMenu.Desktop.DeliveryTriageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Triagem de Delivery • EventMenu" Width="1040" Height="690" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Triagem de Delivery" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Direcione pedidos sem unidade antes que entrem na operação local." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.55*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="CountText" Text="Pedidos aguardando unidade" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" x:Name="OrdersGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="OrdersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="65"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="170"/>
                            <DataGridTextColumn Header="Endereço" Binding="{Binding DeliveryAddress}" Width="*"/>
                            <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="105"/>
                            <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatus}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Criado" Binding="{Binding CreatedDisplay}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Direcionar para unidade" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedOrderText" Text="Selecione um pedido." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                    <TextBlock Text="Unidade" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="UnitSelector" Height="42" VerticalContentAlignment="Center" IsEnabled="False"/>
                    <Button x:Name="AssignButton" Content="Direcionar pedido" Margin="0,12,0,0" IsEnabled="False" Click="AssignButton_Click"/>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                        <TextBlock Text="O servidor confere novamente a empresa, a unidade, o estado do pedido e se ele já possui entregador antes de salvar." Foreground="#1E40AF" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="740"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>