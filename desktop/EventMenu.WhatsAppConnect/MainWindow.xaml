<Window x:Class="EventMenu.WhatsAppConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu WhatsApp Connect"
        Width="940" Height="650" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#16A34A" Margin="0,0,12,0">
                        <TextBlock Text="W" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="EventMenu WhatsApp Connect" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="WhatsApp funcionando com os recursos deste computador" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,9" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TenantText" Text="Empresa" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DeviceText" Text="Computador" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Conexão do WhatsApp" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Escaneie o QR Code uma única vez. A sessão fica salva neste computador." Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,18,0" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="StatusBadge" Background="#F1F5F9" CornerRadius="10" Padding="12,7" VerticalAlignment="Top">
                            <TextBlock x:Name="StatusText" Text="Iniciando..." FontWeight="SemiBold" Foreground="#475569" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,18,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NÚMERO CONECTADO" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="PhoneText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MENSAGENS PENDENTES" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="PendingText" Text="0" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Border x:Name="QrPanel" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="300" Height="300">
                                <Image x:Name="QrImage" Stretch="Uniform" />
                                <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="230">
                                    <TextBlock Text="WhatsApp" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="QrHintText" Text="Clique em Conectar para gerar o QR Code." Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ConnectButton" Content="Conectar / gerar QR" Click="ConnectButton_Click" />
                        <Button x:Name="DisconnectButton" Content="Desconectar" Click="DisconnectButton_Click" Background="#475569" />
                        <Button Content="Atualizar" Click="RefreshButton_Click" Background="#0F172A" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="24" Margin="14,0,0,0">
                <StackPanel>
                    <TextBlock Text="Como funciona" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="O WhatsApp roda neste computador. O servidor EventMenu apenas mantém a fila de mensagens." Foreground="#64748B" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,20" />

                    <Border Background="#ECFDF5" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✓ Sem VPS por restaurante" FontWeight="SemiBold" Foreground="#166534" />
                            <TextBlock Text="Não abre portas no roteador e não precisa de IP fixo." Foreground="#15803D" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✓ Sessão fica no cliente" FontWeight="SemiBold" Foreground="#1D4ED8" />
                            <TextBlock Text="As credenciais do WhatsApp ficam armazenadas localmente no computador do estabelecimento." Foreground="#2563EB" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF7ED" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Atenção" FontWeight="SemiBold" Foreground="#9A3412" />
                            <TextBlock Text="O computador precisa permanecer ligado e com internet para enviar mensagens. Se ficar offline, a fila permanece no EventMenu e será retomada quando voltar." Foreground="#C2410C" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Última atividade" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="ActivityText" Text="Preparando integração..." TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0F172A" CornerRadius="12" Padding="14,10" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Inicializando..." Foreground="#CBD5E1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Pode fechar a janela: o aplicativo continua próximo ao relógio." Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
