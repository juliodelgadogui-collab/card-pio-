<Window x:Class="EventMenu.Desktop.FiscalCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota fiscal • EventMenu" Width="900" Height="620" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Nota fiscal" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="UnitText" Text="Emissão fiscal da unidade" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" x:Name="ReadinessCard" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="ReadinessIcon" Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,20,0">
                    <TextBlock x:Name="ReadinessTitleText" Text="Verificando configuração..." FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReadinessDetailText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="11,7" VerticalAlignment="Center">
                    <TextBlock x:Name="ReadinessBadgeText" Text="Verificando" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border x:Name="ConfigureCard" Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Configurar emissão" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Dados da empresa, ambiente, séries, CSC e certificado digital." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button Content="Abrir configuração" Click="ConfigureButton_Click" HorizontalAlignment="Left" Margin="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" x:Name="ProductsCard" Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Tributação dos produtos" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Confira NCM, CFOP e regras fiscais dos itens vendidos." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button Content="Revisar produtos" Style="{StaticResource SecondaryButton}" Click="ProductsButton_Click" HorizontalAlignment="Left" Margin="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Documentos fiscais" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Acompanhe notas preparadas, autorizadas, rejeitadas ou pendentes." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button Content="Ver notas fiscais" Style="{StaticResource SecondaryButton}" Click="DocumentsButton_Click" HorizontalAlignment="Left" Margin="0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="A emissão de uma nota começa a partir de um pedido apto para emissão." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>