<Window x:Class="EventMenu.Desktop.DeliveryCashReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receber em dinheiro • EventMenu" Width="560" Height="520"
        MinWidth="520" MinHeight="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Receber em dinheiro" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Informe quanto o cliente entregou. O sistema confirma o pagamento no servidor e calcula o troco." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Margin="0,18,0,18">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TOTAL DO PEDIDO" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TROCO" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="ChangeText" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Valor recebido" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ReceivedBox" Height="48" FontSize="20" VerticalContentAlignment="Center"
                         TextChanged="ReceivedBox_TextChanged" PreviewKeyDown="ReceivedBox_PreviewKeyDown"/>
                <TextBlock Text="Exemplo: 50,00" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>

                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                    <TextBlock x:Name="HintText" Text="O recebimento só é permitido depois que o entregador marca Cheguei." Foreground="#1D4ED8" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" Content="Confirmar recebimento" IsEnabled="False" Click="ConfirmButton_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
