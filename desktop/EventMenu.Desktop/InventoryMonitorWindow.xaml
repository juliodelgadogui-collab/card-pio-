<Window x:Class="EventMenu.Desktop.InventoryMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estoque • EventMenu" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Estoque" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="UnitText" Text="Carregando unidade..." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,10,0">
                    <CheckBox x:Name="LowOnlyBox" Content="Mostrar somente itens com atenção" Checked="LowOnlyBox_Changed" Unchecked="LowOnlyBox_Changed"/>
                </Border>
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Produtos controlados" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ControlledText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock Text="com controle de estoque" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Precisam de atenção" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LowText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,7,0,0"/>
                    <TextBlock Text="baixo ou zerado" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Zerados" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ZeroText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,7,0,0"/>
                    <TextBlock Text="sem saldo disponível" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Reservado" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReservedText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock Text="separado em pedidos" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="StockGrid" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="125"/>
                    <DataGridTextColumn Header="Disponível" Binding="{Binding AvailableDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Reservado" Binding="{Binding ReservedDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Físico" Binding="{Binding PhysicalDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Atualização automática ativa." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Fechar" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
