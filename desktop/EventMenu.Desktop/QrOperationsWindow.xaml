<Window x:Class="EventMenu.Desktop.QrOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ler código • EventMenu" Width="760" Height="610" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ler QR ou código" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Use um leitor, cole o código ou digite manualmente." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Código" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CodeBox" Height="44" Margin="0" FontSize="15" VerticalContentAlignment="Center" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                </StackPanel>
                <Button Grid.Column="1" Content="Consultar" Height="44" MinHeight="44" Margin="12,22,0,0" Padding="20,8" Click="ResolveButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" x:Name="ResultCard" Style="{StaticResource Card}" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="TypeText" Text="AGUARDANDO LEITURA" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="ResultTitleText" Text="Leia um código para começar" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="StateBadge" DockPanel.Dock="Right" Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="10,6" VerticalAlignment="Top">
                        <TextBlock x:Name="StateText" Text="Pronto" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock x:Name="PrimaryInfoText" Text="O resultado aparecerá aqui." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SecondaryInfoText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="TertiaryInfoText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />

                    <Border x:Name="TableLabelPanel" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Identificação da comanda" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TableLabelBox" Height="40" Margin="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock x:Name="OperationStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="ActionButton" Content="Ação" HorizontalAlignment="Right" Visibility="Collapsed" Click="ActionButton_Click" Margin="0" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Dica: leitores USB normalmente enviam Enter automaticamente após a leitura." Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>