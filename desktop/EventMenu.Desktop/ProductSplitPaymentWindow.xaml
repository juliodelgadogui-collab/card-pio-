<Window x:Class="EventMenu.Desktop.ProductSplitPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dividir por produtos • EventMenu" Width="900" Height="700" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Dividir por produtos" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Selecione os produtos que esta pessoa vai pagar. Cada linha da comanda é cobrada por inteiro." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Produtos disponíveis" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AvailableCountText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="ItemsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ItemsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="80"/>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Resumo" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="ITENS SELECIONADOS" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
                    <TextBlock x:Name="SelectedCountText" Text="0" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="VALOR" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                    <TextBlock x:Name="SelectedTotalText" Text="R$ 0,00" FontSize="25" FontWeight="SemiBold"/>

                    <TextBlock Text="Forma de pagamento" Style="{StaticResource FieldLabel}" Margin="0,20,0,0"/>
                    <ComboBox x:Name="PaymentMethodCombo" Height="42" SelectionChanged="PaymentMethodCombo_SelectionChanged"/>

                    <StackPanel x:Name="PixPanel" Margin="0,14,0,0">
                        <TextBlock Text="CPF ou CNPJ do pagador" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TaxIdBox" Height="42" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="ChargeButton" Content="Continuar" Height="44" Margin="0,18,0,0" IsEnabled="False" Click="ChargeButton_Click"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>