<Window x:Class="EventMenu.Desktop.DeliveryMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entregas ao vivo • EventMenu" Width="1200" Height="700"
        MinWidth="960" MinHeight="580" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Entregas ao vivo" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Veja onde estão as entregas que estão em rota agora." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="#DBEAFE" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Text="Carregando entregas..." FontWeight="SemiBold" />
                    <TextBlock Text="A localização aparece somente durante a rota ativa." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="DeliveriesGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DeliveriesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Entregador" Binding="{Binding DeliveryName}" Width="165" />
                    <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="80" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="150" />
                    <DataGridTextColumn Header="Destino" Binding="{Binding DeliveryAddress}" Width="*" MinWidth="240" />
                    <DataGridTextColumn Header="Sinal" Binding="{Binding OnlineLabel}" Width="115" />
                    <DataGridTextColumn Header="Precisão" Binding="{Binding AccuracyLabel}" Width="90" />
                    <DataGridTextColumn Header="Velocidade" Binding="{Binding SpeedLabel}" Width="95" />
                    <DataGridTextColumn Header="Última posição" Binding="{Binding RecordedAt}" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,18,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MapButton" Content="Abrir no mapa" IsEnabled="False" Click="MapButton_Click" />
                    <Button x:Name="CopyButton" Content="Copiar posição" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CopyButton_Click" />
                    <Button Content="Fechar" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
