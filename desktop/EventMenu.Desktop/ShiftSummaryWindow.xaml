<Window x:Class="EventMenu.Desktop.ShiftSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meu turno • EventMenu" Width="900" Height="650" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Meu turno" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="ShiftSubtitleText" Text="Resumo das operações realizadas neste turno." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="PEDIDOS" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="OrdersCountText" Text="—" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="OrdersTotalText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="INÍCIO" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="StartedText" Text="—" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UnitText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="MODO" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ModeText" Text="—" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ShiftStateText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Movimentação por forma" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" x:Name="MethodsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Forma" Binding="{Binding MethodDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Movimento" Binding="{Binding DirectionDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Qtd." Binding="{Binding Qty}" Width="70"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border x:Name="DeliveryCashCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Dinheiro do Delivery" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CashCollectedText" Margin="0,12,0,0"/>
                        <TextBlock x:Name="CashHandoffText" Margin="0,5,0,0"/>
                        <TextBlock x:Name="CashOutstandingText" Margin="0,5,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CommissionCard" Style="{StaticResource Card}" Padding="18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Comissão de entrega" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CommissionDeliveriesText" Margin="0,12,0,0"/>
                        <TextBlock x:Name="CommissionRevenueText" Margin="0,5,0,0"/>
                        <TextBlock x:Name="CommissionTotalText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>