<Window x:Class="EventMenu.Desktop.HubPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectar celular • EventMenu" Width="620" Height="760" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Conectar EventMenu GO" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Vincule o celular a este computador com segurança." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Border Grid.Column="1" Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#17B26A" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Código temporário" Foreground="#067647" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="4,0,12,0">
                    <TextBlock Text="1" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Abra o EventMenu GO no celular" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="2" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Escolha Conectar computador" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,4,0">
                    <TextBlock Text="3" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Leia o QR Code abaixo" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24" Margin="0,18,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="286" Height="286" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="14" HorizontalAlignment="Center">
                    <Image x:Name="PairingQrImage" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="Escaneie com o EventMenu GO" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ExpiresText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="18,18,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="Código manual" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="PairingCodeText" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1" Content="Copiar" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="18,10" Click="CopyButton_Click" />
                </Grid>

                <Border Grid.Row="3" Background="#FFFAEB" BorderBrush="#FEDF89" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,16,0,0">
                    <TextBlock Text="O código funciona uma única vez e expira automaticamente. O celular e o computador podem estar em redes diferentes." Foreground="#93370D" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock Text="Mantenha esta janela aberta até concluir a conexão no celular." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Padding="18,9" />
        </Grid>
    </Grid>
</Window>
