<Window x:Class="EventMenu.Desktop.OrderPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receber pedido"
        Width="590" Height="650" MinWidth="540" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Receber pedido" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Text="Confira o saldo restante e escolha a forma de pagamento." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,14" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="PAGO" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="PaidText" Text="R$ 0,00" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12,9">
                    <StackPanel>
                        <TextBlock Text="FALTA RECEBER" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="RemainingText" Text="R$ 0,00" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Quanto receber agora?" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AmountBox" Height="48" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Você pode receber tudo ou registrar apenas uma parte. O restante continua no pedido." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <TextBlock Text="Como o cliente vai pagar?" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Escolha uma opção. O pedido só será marcado como pago depois da confirmação válida." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,16" />

                <Button x:Name="CashButton" Content="Dinheiro" Height="54" Click="CashButton_Click" FontSize="14" />
                <Button x:Name="PixButton" Content="PIX" Height="54" Style="{StaticResource SecondaryButton}" Click="PixButton_Click" Margin="0,6,0,0" FontSize="14" />

                <Border x:Name="PaidBanner" Visibility="Collapsed" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,7,0" />
                        <TextBlock Text="Pagamento confirmado" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button Content="Atualizar situação" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" MinWidth="132" />
            <Button Content="Fechar" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0" MinWidth="82" />
        </DockPanel>
    </Grid>
</Window>
