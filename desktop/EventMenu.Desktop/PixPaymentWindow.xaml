<Window x:Class="EventMenu.Desktop.PixPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pix • EventMenu"
        Width="600" Height="750"
        MinWidth="540" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Receber com Pix" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="OrderText" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,20,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CPF ou CNPJ" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TaxIdBox" Height="42" MaxLength="18" />
                    <TextBlock Text="Do cliente que está pagando" Foreground="#94A3B8" FontSize="10" Margin="1,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Valor" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AmountBox" Height="42" />
                    <TextBlock Text="Valor que será cobrado" Foreground="#94A3B8" FontSize="10" Margin="1,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button x:Name="GenerateButton" Content="Gerar cobrança Pix" Height="46" Margin="0,0,0,16" Click="GenerateButton_Click" />

                    <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                        <TextBlock x:Name="StatusText" Text="Informe os dados acima para gerar a cobrança." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="QrBorder" Visibility="Collapsed" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="CopyPasteLabel" Text="Código Pix copia e cola" Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
                    <TextBox x:Name="CopyPasteBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="96" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    <Button x:Name="CopyButton" Content="Copiar código" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" HorizontalAlignment="Left" Click="CopyButton_Click" />
                    <TextBlock x:Name="ExpiresText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,8,0" />
                <TextBlock x:Name="PollingText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="Fechar" Style="{StaticResource SecondaryButton}" Margin="0" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
