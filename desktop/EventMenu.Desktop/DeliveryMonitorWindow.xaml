<Window x:Class="EventMenu.Desktop.DeliveryMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu • Entregas ao vivo" Width="1180" Height="680"
        MinWidth="940" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Entregas ao vivo" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Acompanhe somente entregadores com rota ativa nesta unidade." Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Atualizar" Width="105" Height="36" Click="RefreshButton_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SummaryText" Text="Carregando..." FontWeight="SemiBold" />
                <TextBlock Text="  •  GPS é exibido apenas enquanto a rota estiver em andamento." Foreground="#667085" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10">
            <DataGrid x:Name="DeliveriesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionChanged="DeliveriesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Entregador" Binding="{Binding DeliveryName}" Width="160" />
                    <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="75" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="150" />
                    <DataGridTextColumn Header="Destino" Binding="{Binding DeliveryAddress}" Width="*" MinWidth="220" />
                    <DataGridTextColumn Header="Sinal" Binding="{Binding OnlineLabel}" Width="105" />
                    <DataGridTextColumn Header="Precisão" Binding="{Binding AccuracyLabel}" Width="90" />
                    <DataGridTextColumn Header="Velocidade" Binding="{Binding SpeedLabel}" Width="95" />
                    <DataGridTextColumn Header="Última posição" Binding="{Binding ReceivedAt}" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,14,0" />
            <Button x:Name="MapButton" Grid.Column="1" Content="Abrir no mapa" Width="125" IsEnabled="False" Click="MapButton_Click" />
            <Button x:Name="CopyButton" Grid.Column="3" Content="Copiar posição" Width="125" IsEnabled="False" Click="CopyButton_Click" />
            <Button Grid.Column="5" Content="Fechar" Width="90" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
