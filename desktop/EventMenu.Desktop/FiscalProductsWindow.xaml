<Window x:Class="EventMenu.Desktop.FiscalProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu • Tributação dos produtos" Width="1120" Height="760"
        MinWidth="980" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Tributação dos produtos" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Complete os dados usados na NFC-e/NF-e. O EventMenu valida preenchimento, mas não escolhe a classificação fiscal por você."
                           Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="760" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Atualizar" Width="100" Height="34" Click="RefreshButton_Click" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Height="36" Margin="0,0,0,10" TextChanged="SearchBox_TextChanged"
                             ToolTip="Pesquise por nome, SKU, NCM ou CFOP" />
                    <TextBlock x:Name="ListSummaryText" Grid.Row="1" Foreground="#667085" Margin="0,0,0,8" />
                    <DataGrid x:Name="ProductsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="ProductsGrid_SelectionChanged"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" />
                            <DataGridTextColumn Header="Fiscal" Binding="{Binding ReadinessLabel}" Width="82" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="SelectedProductNameText" Text="Selecione um produto" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedProductStatusText" Foreground="#667085" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="FiscalProductEnabledCheck" DockPanel.Dock="Right" Content="Usar na emissão fiscal"
                                      VerticalAlignment="Center" IsChecked="True" />
                        </DockPanel>

                        <Border Background="#FFF7ED" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="NCM, CFOP, CST/CSOSN e alíquotas devem corresponder à realidade tributária da empresa. Confirme a classificação com o contador/responsável fiscal antes de usar em produção."
                                       Foreground="#9A3412" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Produto e operação" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NCM (8 dígitos)" FontWeight="SemiBold"/><TextBox x:Name="NcmBox" MaxLength="8" Margin="0,4,0,10"/>
                                <TextBlock Text="CFOP (4 dígitos)" FontWeight="SemiBold"/><TextBox x:Name="CfopBox" MaxLength="4" Margin="0,4,0,10"/>
                                <TextBlock Text="Unidade comercial" FontWeight="SemiBold"/><TextBox x:Name="CommercialUnitBox" MaxLength="6" Margin="0,4,0,10"/>
                                <TextBlock Text="GTIN/EAN (opcional)" FontWeight="SemiBold"/><TextBox x:Name="GtinBox" MaxLength="14" Margin="0,4,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CEST (opcional)" FontWeight="SemiBold"/><TextBox x:Name="CestBox" MaxLength="7" Margin="0,4,0,10"/>
                                <TextBlock Text="Origem da mercadoria (0–8)" FontWeight="SemiBold"/><TextBox x:Name="OriginBox" MaxLength="1" Margin="0,4,0,10"/>
                                <TextBlock Text="Unidade tributável" FontWeight="SemiBold"/><TextBox x:Name="TributaryUnitBox" MaxLength="6" Margin="0,4,0,10"/>
                                <TextBlock Text="GTIN tributável (opcional)" FontWeight="SemiBold"/><TextBox x:Name="GtinTributaryBox" MaxLength="14" Margin="0,4,0,10"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#EAECF0" Margin="0,10,0,16" />
                        <TextBlock Text="ICMS" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CST" FontWeight="SemiBold"/><TextBox x:Name="IcmsCstBox" MaxLength="3" Margin="0,4,0,10" ToolTip="Use no regime normal quando aplicável."/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="CSOSN" FontWeight="SemiBold"/><TextBox x:Name="IcmsCsosnBox" MaxLength="3" Margin="0,4,0,10" ToolTip="Use no Simples Nacional quando aplicável."/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Alíquota ICMS (%)" FontWeight="SemiBold"/><TextBox x:Name="IcmsRateBox" Margin="0,4,0,10"/></StackPanel>
                        </Grid>

                        <TextBlock Text="PIS e COFINS" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CST PIS" FontWeight="SemiBold"/><TextBox x:Name="PisCstBox" MaxLength="2" Margin="0,4,0,10"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="PIS (%)" FontWeight="SemiBold"/><TextBox x:Name="PisRateBox" Margin="0,4,0,10"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="CST COFINS" FontWeight="SemiBold"/><TextBox x:Name="CofinsCstBox" MaxLength="2" Margin="0,4,0,10"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="COFINS (%)" FontWeight="SemiBold"/><TextBox x:Name="CofinsRateBox" Margin="0,4,0,10"/></StackPanel>
                        </Grid>

                        <TextBlock Text="IPI e benefício fiscal (opcionais)" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CST IPI" FontWeight="SemiBold"/><TextBox x:Name="IpiCstBox" MaxLength="2" Margin="0,4,0,10"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="IPI (%)" FontWeight="SemiBold"/><TextBox x:Name="IpiRateBox" Margin="0,4,0,10"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Código de benefício" FontWeight="SemiBold"/><TextBox x:Name="BenefitCodeBox" MaxLength="20" Margin="0,4,0,10"/></StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SaveButton" Content="Salvar tributação" Width="160" Click="SaveButton_Click" />
                            <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#667085" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Nenhum dado fiscal é sugerido automaticamente pelo EventMenu." Foreground="#667085" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Fechar" Width="90" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
