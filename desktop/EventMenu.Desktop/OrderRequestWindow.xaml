<Window x:Class="EventMenu.Desktop.OrderRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitação • EventMenu" Width="520" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Solicitação" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Text="Pedido" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,18,0,16">
            <StackPanel>
                <StackPanel x:Name="AmountPanel">
                    <TextBlock Text="Valor do desconto" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AmountBox" Height="42" Margin="0,0,0,16" VerticalContentAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ReasonLabel" Text="Motivo" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ReasonBox" Height="118" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="500" />
                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                    <TextBlock x:Name="InfoText" Text="A solicitação seguirá as regras de autorização da empresa." Foreground="#9A3412" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" MaxWidth="270" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" />
                <Button x:Name="SubmitButton" Content="Enviar solicitação" Click="SubmitButton_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>