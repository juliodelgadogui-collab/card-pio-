<Window x:Class="EventMenu.Desktop.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprovante • EventMenu" Width="940" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" Text="Comprovante" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Text="Carregando..." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="PrintButton" Content="Imprimir" IsEnabled="False" Click="PrintButton_Click" Margin="0" />
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="BusinessNameText" Text="—" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="BusinessDetailText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="COMPROVANTE NÃO FISCAL" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="PEDIDO" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="OrderText" Text="—" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="CustomerText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="TotalText" Text="—" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="PaidText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Itens" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" x:Name="ReceiptItemsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="65" />
                            <DataGridTextColumn Header="Unitário" Binding="{Binding UnitPriceDisplay}" Width="105" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resumo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DockPanel Margin="0,4"><TextBlock Text="Subtotal" /><TextBlock x:Name="SubtotalText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                            <DockPanel Margin="0,4"><TextBlock Text="Desconto" /><TextBlock x:Name="DiscountText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                            <DockPanel Margin="0,4"><TextBlock Text="Entrega" /><TextBlock x:Name="DeliveryFeeText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                            <Separator Margin="0,10" />
                            <DockPanel Margin="0,4"><TextBlock Text="Total" FontWeight="SemiBold" /><TextBlock x:Name="SummaryTotalText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" /></DockPanel>
                            <DockPanel Margin="0,4"><TextBlock Text="Pago" /><TextBlock x:Name="SummaryPaidText" DockPanel.Dock="Right" HorizontalAlignment="Right" /></DockPanel>
                            <DockPanel Margin="0,4"><TextBlock Text="Restante" /><TextBlock x:Name="RemainingText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Pagamentos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <DataGrid x:Name="PaymentsGrid" Height="180" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Forma" Binding="{Binding MethodDisplay}" Width="*" />
                                    <DataGridTextColumn Header="Valor" Binding="{Binding AmountDisplay}" Width="95" />
                                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <TextBlock x:Name="FooterMessageText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Para emissão fiscal, use a área Nota fiscal." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>