<Window x:Class="EventMenu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu Desktop"
        Width="1280" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid x:Name="LoginPanel" Background="#F4F7FB">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111827" Padding="64">
                <StackPanel VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="EVENTMENU" Foreground="#C4B5FD" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="Operação do restaurante em uma tela feita para o computador."
                               Foreground="White" FontWeight="SemiBold" FontSize="36"
                               TextWrapping="Wrap" Margin="0,18,0,18" />
                    <TextBlock Foreground="#CBD5E1" FontSize="17" TextWrapping="Wrap"
                               Text="Pedidos, caixa, catálogo e operação conectados ao mesmo servidor do cardápio e do aplicativo." />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="72">
                <Border Background="White" CornerRadius="18" Padding="38" MaxWidth="430" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.12" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Entrar" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Use o mesmo acesso da sua empresa no EventMenu." Foreground="#667085" Margin="0,8,0,28" TextWrapping="Wrap" />

                        <TextBlock Text="E-mail" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="EmailBox" Height="42" Margin="0,0,0,18" />

                        <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,0,0,22" KeyDown="PasswordBox_KeyDown" />

                        <Button x:Name="LoginButton" Content="Entrar no EventMenu" Height="44" Click="LoginButton_Click" />
                        <TextBlock x:Name="LoginStatus" Foreground="#B42318" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ShellPanel" Visibility="Collapsed" Background="#F4F7FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EventMenu" FontWeight="Bold" FontSize="20" />
                        <Border Background="#F2F4F7" CornerRadius="8" Padding="10,5" Margin="16,0,0,0">
                            <TextBlock x:Name="TenantNameText" FontWeight="SemiBold" Foreground="#475467" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="UserNameText" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="RoleText" Foreground="#667085" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Content="Sair" Style="{StaticResource SecondaryButton}" Click="LogoutButton_Click" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#111827" Padding="16,22">
                    <StackPanel>
                        <TextBlock Text="OPERAÇÃO" Foreground="#98A2B3" FontWeight="Bold" FontSize="11" Margin="10,0,0,14" />
                        <Button Content="Visão geral" HorizontalContentAlignment="Left" Click="DashboardButton_Click" />
                        <Button Content="Pedidos" HorizontalContentAlignment="Left" Click="OrdersButton_Click" />
                        <Button Content="Produtos / PDV" HorizontalContentAlignment="Left" Click="ProductsButton_Click" />
                        <Button x:Name="CashNavButton" Content="Caixa" HorizontalContentAlignment="Left" Click="CashButton_Click" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="28">
                    <Grid x:Name="DashboardView">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,22">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Visão geral" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="Resumo da operação deste acesso." Foreground="#667085" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Content="Atualizar" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="RefreshButton_Click" />
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,14,0">
                                    <StackPanel><TextBlock Text="Pedidos carregados" Foreground="#667085" /><TextBlock x:Name="OrdersCountText" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" /></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,14,0">
                                    <StackPanel><TextBlock Text="Produtos ativos" Foreground="#667085" /><TextBlock x:Name="ProductsCountText" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" /></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="14" Padding="22">
                                    <StackPanel><TextBlock Text="Conexão" Foreground="#667085" /><TextBlock x:Name="ConnectionText" Text="Servidor conectado" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="White" CornerRadius="14" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Primeira etapa do Desktop" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,10,0,0" Foreground="#667085" TextWrapping="Wrap"
                                               Text="Esta versão já usa a autenticação real do servidor e lê pedidos, produtos e estado do caixa conforme as permissões do usuário. As próximas telas vão acrescentar criação de pedido, mesas/comandas, impressão e operação offline controlada." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="OrdersView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Pedidos" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Pedidos liberados para a função deste usuário." Foreground="#667085" Margin="0,6,0,0" /></StackPanel>
                            <Button Content="Atualizar pedidos" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="RefreshOrdersButton_Click" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12">
                            <DataGrid x:Name="OrdersGrid" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*" />
                                    <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="120" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                                    <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatus}" Width="140" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Criado em" Binding="{Binding CreatedAt}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ProductsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Produtos / PDV" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Catálogo ativo da empresa. A montagem do carrinho entra na próxima etapa." Foreground="#667085" Margin="0,6,0,0" /></StackPanel>
                            <Button Content="Atualizar produtos" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="RefreshProductsButton_Click" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12">
                            <DataGrid x:Name="ProductsGrid" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
                                    <DataGridTextColumn Header="Preço" Binding="{Binding PriceDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Estoque" Binding="{Binding StockQty}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <Grid x:Name="CashView" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <StackPanel DockPanel.Dock="Left"><TextBlock Text="Caixa" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Situação da sessão de caixa atual." Foreground="#667085" Margin="0,6,0,0" /></StackPanel>
                                <Button Content="Atualizar caixa" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="RefreshCashButton_Click" />
                            </DockPanel>
                            <Border Background="White" CornerRadius="14" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Sessão atual" Foreground="#667085" />
                                    <TextBlock x:Name="CashStatusText" Text="Carregando..." FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock x:Name="CashDetailsText" Foreground="#667085" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
