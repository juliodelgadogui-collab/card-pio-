APP_NAME="EventMenu Premium"
APP_ENV=production
APP_DEBUG=false
# Domínio oficial da instalação EventMenu.
APP_URL=https://go.gestao2.store
# Backend e APIs do EventMenu GO instalados em https://go.gestao2.store/1/
APP_BASE_PATH=/1
APP_KEY=change-me-with-a-long-random-secret
# Segredo longo para chamar cron.php via HTTP usando o cabeçalho X-Cron-Secret
CRON_SECRET=change-me-with-another-long-random-secret

# Compatibilidade e manutenção do EventMenu GO
APP_MIN_VERSION=0.2.0
APP_RECOMMENDED_VERSION=
APP_MAINTENANCE=false
APP_MAINTENANCE_MESSAGE="Sistema em manutenção. Tente novamente em alguns minutos."

# Primeira instalação: SQLite. Em produção com concorrência, prefira MySQL/MariaDB.
DB_CONNECTION=sqlite

# SQLite
DB_SQLITE_PATH=storage/eventmenu.sqlite

# MySQL/MariaDB (usado somente quando DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eventmenu
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=eventmenu_session
SESSION_SECURE=true

# Fila e backup. Configure o cron do servidor para executar public/cron.php a cada minuto.
QUEUE_BATCH_SIZE=40
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_BIN=mysqldump

# Pix bancário Efí / Banco Inter.
# Quantidade máxima de cobranças pendentes conciliadas em cada execução da manutenção.
# O EventMenu também consulta o banco enquanto o cliente aguarda a confirmação no app.
BANK_PIX_RECONCILE_BATCH=40

# Delivery: posição exata só é aceita durante rota ativa. O histórico é removido pelo cron.
# Mantenha uma retenção curta; o EventMenu limita este valor internamente a 1-90 dias.
DELIVERY_LOCATION_RETENTION_DAYS=14

# Firebase Cloud Messaging HTTP v1. Prefira armazenar o JSON fora da pasta public.
# Opção 1: caminho para o JSON da conta de serviço.
FCM_SERVICE_ACCOUNT_PATH=
# Opção 2: JSON completo codificado em base64.
FCM_SERVICE_ACCOUNT_BASE64=
# Opção 3: campos separados; a chave privada deve estar em base64.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_BASE64=

PAYMENT_CURRENCY=BRL
STRIPE_WEBHOOK_SECRET=
PAGBANK_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp / EventMenu Connect
# Não instale WPPConnect, bridge, Node.js ou Baileys nesta hospedagem.
# A sessão do WhatsApp e o Baileys ficam embarcados no aplicativo EventMenu Connect.
# O servidor apenas mantém filas, conversas, automações e ACKs consumidos pela API do Connect.
WHATSAPP_OUTBOX_BATCH=20
WHATSAPP_EVENT_SYNC_BATCH=100