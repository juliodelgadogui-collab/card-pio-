<Window x:Class="EventMenu.Desktop.OrderPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receber pedido"
        Width="560" Height="600" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Receber pedido" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Text="Confira o valor e escolha como o cliente vai pagar." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,14" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="PAGO" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="PaidText" Text="R$ 0,00" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RESTANTE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="RemainingText" Text="R$ 0,00" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Valor a receber" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AmountBox" Height="44" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Você pode receber o valor total ou somente uma parte." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
                <TextBlock Text="Forma de pagamento" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                <Button x:Name="CashButton" Content="Receber em dinheiro" Height="48" Click="CashButton_Click" />
                <Button x:Name="PixButton" Content="Gerar Pix" Height="48" Style="{StaticResource SecondaryButton}" Click="PixButton_Click" Margin="0,4,0,0" />
                <Border x:Name="PaidBanner" Visibility="Collapsed" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                    <TextBlock Text="Pagamento concluído" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" />
            <Button Content="Fechar" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0" />
        </DockPanel>
    </Grid>
</Window>
