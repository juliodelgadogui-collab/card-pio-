APP_NAME="EventMenu Premium"
APP_ENV=production
APP_DEBUG=false
# Informe apenas a origem do site. Ex.: https://seudominio.com.br
APP_URL=http://localhost
# Pacote preparado para instalar em https://dominio/1/
APP_BASE_PATH=/1
APP_KEY=change-me-with-a-long-random-secret
# Segredo longo para chamar cron.php via HTTP usando o cabeçalho X-Cron-Secret
CRON_SECRET=change-me-with-another-long-random-secret

# mysql ou sqlite
DB_CONNECTION=mysql

# MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eventmenu
DB_USERNAME=root
DB_PASSWORD=

# SQLite (usado quando DB_CONNECTION=sqlite)
DB_SQLITE_PATH=storage/eventmenu.sqlite

SESSION_NAME=eventmenu_session
SESSION_SECURE=false

PAYMENT_CURRENCY=BRL
STRIPE_WEBHOOK_SECRET=
PAGBANK_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
