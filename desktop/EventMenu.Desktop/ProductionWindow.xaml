<Window x:Class="EventMenu.Desktop.ProductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produção • EventMenu" Width="1220" Height="780" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Produção" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubtitleText" Text="Acompanhe o preparo e libere pedidos no momento certo." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ConnectionText" Text="Atualizando..." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <TabControl x:Name="ProductionTabs" Margin="8">
                <TabItem Header="Preparo">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Background="#F8FAFC" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,14">
                                    <TextBlock Text="Estações" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Escolha cozinha, bar ou outra área." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ListBox x:Name="StationsList" DisplayMemberPath="Name" SelectionChanged="StationsList_SelectionChanged"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StationTitle" Text="Pedidos em preparo" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StationInfo" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Height="40" VerticalAlignment="Center" ToolTip="Buscar pedido, item, mesa ou cliente" TextChanged="SearchBox_TextChanged"/>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                                <DataGrid x:Name="JobsGrid" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="75"/>
                                        <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="65"/>
                                        <DataGridTextColumn Header="Mesa" Binding="{Binding TableName}" Width="95"/>
                                        <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="145"/>
                                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="105"/>
                                        <DataGridTextColumn Header="Tempo" Binding="{Binding TimeLabel}" Width="135"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="StartButton" Content="Iniciar preparo" Style="{StaticResource SecondaryButton}" Click="StartButton_Click"/>
                                        <Button x:Name="ReadyButton" Content="Marcar pronto" Click="ReadyButton_Click"/>
                                        <Button x:Name="ExpediteItemButton" Content="Liberar item" Style="{StaticResource SecondaryButton}" Click="ExpediteItemButton_Click" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="JobStatusText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Expedição">
                    <Grid Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Pedidos prontos para sair" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Confira se todo o pedido está pronto antes de liberar." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                            <DataGrid x:Name="ExpeditionGrid" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pedido" Binding="{Binding Id}" Width="70"/>
                                    <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="95"/>
                                    <DataGridTextColumn Header="Mesa" Binding="{Binding TableName}" Width="95"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn Header="Entrega" Binding="{Binding DeliveryDisplay}" Width="230"/>
                                    <DataGridTextColumn Header="Prontos" Binding="{Binding JobsReady}" Width="75"/>
                                    <DataGridTextColumn Header="Itens" Binding="{Binding JobsTotal}" Width="65"/>
                                    <DataGridCheckBoxColumn Header="Completo" Binding="{Binding AllReady}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Pedidos incompletos permanecem bloqueados para liberação." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="ExpediteOrderButton" Grid.Column="1" Content="Liberar pedido" Click="ExpediteOrderButton_Click" Margin="0"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PrintersTab" Header="Impressão">
                    <Grid Margin="20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Impressão por estação" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Escolha em qual impressora os pedidos de cada área devem sair. O sistema cuida para não repetir a mesma impressão." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Background="#F8FAFC">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Estação" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PrinterStationCombo" DisplayMemberPath="Name" SelectionChanged="PrinterStationCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Impressora" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="StationPrinterBox" ToolTip="Digite o nome da impressora instalada no Windows."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox x:Name="AutomaticPrintCheck" Content="Imprimir automaticamente" Margin="0,0,22,0"/>
                            <CheckBox x:Name="BindThisPcCheck" Content="Usar somente neste computador" IsChecked="True" Margin="0,0,22,0"/>
                            <Button x:Name="SavePrinterButton" Content="Salvar" Click="SavePrinterButton_Click" Margin="0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" x:Name="PrinterStatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Fechar" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
