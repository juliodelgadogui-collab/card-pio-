<Window x:Class="EventMenu.Desktop.TableBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salão • EventMenu" Width="1040" Height="720" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Salão" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Selecione uma mesa para abrir ou encerrar a comanda." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <ListBox x:Name="TablesList" BorderThickness="0" Background="Transparent" SelectionChanged="TablesList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Width="220" MinHeight="142">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#94A3B8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="8" Padding="8,4">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding TabLabel, TargetNullValue='Sem comanda'}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                                <TextBlock Text="Em aberto" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding UnpaidDisplay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedTableText" Text="Selecione uma mesa" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="SelectedTableDetailText" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox x:Name="TabLabelBox" Grid.Column="1" Height="40" Margin="14,0" VerticalAlignment="Center" ToolTip="Nome ou identificação da comanda" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Content="Abrir comanda" Click="OpenButton_Click" IsEnabled="False" />
                    <Button x:Name="CloseTabButton" Content="Fechar comanda" Style="{StaticResource SecondaryButton}" Click="CloseTabButton_Click" IsEnabled="False" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>