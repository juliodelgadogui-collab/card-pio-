<Window x:Class="EventMenu.Desktop.FiscalDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventMenu • Documentos fiscais" Width="1080" Height="650"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Documentos fiscais" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Acompanhe a fila e diferencie preparação, processamento, rejeição e autorização SEFAZ."
                           Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Atualizar" Width="100" Height="34" Click="RefreshButton_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12">
            <DataGrid x:Name="DocumentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionChanged="DocumentsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="75" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Model}" Width="65" />
                    <DataGridTextColumn Header="Série" Binding="{Binding Series}" Width="65" />
                    <DataGridTextColumn Header="Número" Binding="{Binding DocumentNumber}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105" />
                    <DataGridTextColumn Header="Chave de acesso" Binding="{Binding AccessKey}" Width="260" />
                    <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="150" />
                    <DataGridTextColumn Header="Criado" Binding="{Binding CreatedAt}" Width="150" />
                    <DataGridTextColumn Header="Motivo" Binding="{Binding RejectionMessage}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="DetailText" Foreground="#667085" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820" />
            <Button DockPanel.Dock="Right" Content="Fechar" Width="90" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
