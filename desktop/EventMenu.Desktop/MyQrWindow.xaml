<Window x:Class="EventMenu.Desktop.MyQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meu QR • EventMenu" Width="760" Height="680" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Meu QR" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Seu código de identificação para operações autorizadas no EventMenu." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="NameText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="RoleText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CompanyText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>

                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock x:Name="StateTitleText" Text="QR ainda não gerado" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StateDetailText" Text="Gere seu código para utilizá-lo nas operações compatíveis." Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="GenerateButton" Content="Gerar meu QR" Height="44" Click="GenerateButton_Click"/>
                        <Button x:Name="CopyButton" Content="Copiar código" Style="{StaticResource SecondaryButton}" Height="42" Visibility="Collapsed" Click="CopyButton_Click" Margin="0,10,0,0"/>
                        <Button x:Name="RevokeButton" Content="Revogar QR" Style="{StaticResource SecondaryButton}" Height="42" Visibility="Collapsed" Click="RevokeButton_Click" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="QrBorder" Width="300" Height="300" Background="#F8FAFC" CornerRadius="12">
                            <Grid>
                                <Image x:Name="QrImage" Width="276" Height="276" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="EmptyQrPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="QR" FontSize="42" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Gere seu código" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ExpiryText" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="300"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="580"/>
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
