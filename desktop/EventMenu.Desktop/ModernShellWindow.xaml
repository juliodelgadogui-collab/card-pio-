<Window x:Class="EventMenu.Desktop.ModernShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EventMenu"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7FB">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />

        <Grid x:Name="LoadingPanel" Background="#F6F7FB">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="17" Background="#0F172A" Margin="0,0,0,18">
                    <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="EventMenu" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock x:Name="LoadingText" Text="Preparando sua operação..." HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#64748B" />
            </StackPanel>
        </Grid>

        <Grid x:Name="FallbackPanel" Visibility="Collapsed" Background="#F6F7FB">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="32" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Não foi possível abrir a nova interface" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                    <TextBlock x:Name="FallbackText" Text="Você pode continuar usando o modo clássico enquanto verificamos a interface." Foreground="#64748B" Margin="0,10,0,22" TextWrapping="Wrap" />
                    <Button Content="Abrir modo clássico" Height="44" Click="OpenLegacyButton_Click" />
                    <Button Content="Tentar novamente" Height="42" Style="{StaticResource SecondaryButton}" Click="RetryButton_Click" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
