<Window x:Class="EventMenu.Desktop.ManagerCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerência • EventMenu" Width="1180" Height="790" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Central gerencial" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Operação, caixa, entregas, alertas e correções em uma única tela." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" />
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Pedidos agora" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="OrdersNowText" Text="—" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Atrasados" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="DelayedText" Text="—" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Prontos" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ReadyText" Text="—" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Sem entregador" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="UnassignedText" Text="—" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Pag. pendentes" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PaymentsText" Text="—" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="Vendas hoje" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="RevenueText" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>

        <TabControl Grid.Row="2" x:Name="ManagerTabs">
            <TabItem Header="Alertas">
                <Grid Margin="12">
                    <DataGrid x:Name="AlertsGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nível" Binding="{Binding LevelDisplay}" Width="100" />
                            <DataGridTextColumn Header="Alerta" Binding="{Binding Title}" Width="220" />
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Pedidos com atenção">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="ProblemOrdersGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="ProblemOrdersGrid_SelectionChanged" MouseDoubleClick="ProblemOrdersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="180" />
                            <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="105" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding ProblemType}" Width="160" />
                            <DataGridTextColumn Header="Pedido" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatus}" Width="120" />
                            <DataGridTextColumn Header="Entregador" Binding="{Binding DeliveryName}" Width="160" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="105" />
                            <DataGridTextColumn Header="Atualizado" Binding="{Binding UpdatedDisplay}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProblemHintText" Text="Selecione um pedido para ver as ações disponíveis." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ComboBox x:Name="DeliverySelector" Grid.Column="1" Height="40" Margin="12,0" VerticalContentAlignment="Center" IsEnabled="False"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="TransferDeliveryButton" Content="Trocar entregador" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="TransferDeliveryButton_Click" />
                            <Button Content="Abrir pedido" Click="OpenProblemOrderButton_Click" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Caixas e entregadores">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Caixas abertos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" x:Name="CashSessionsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Operador" Binding="{Binding UserName}" Width="*" />
                                    <DataGridTextColumn Header="Abertura" Binding="{Binding OpeningDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Desde" Binding="{Binding OpenedDisplay}" Width="155" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Entregadores em turno" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" x:Name="DeliveryShiftsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Entregador" Binding="{Binding UserName}" Width="*" />
                                    <DataGridTextColumn Header="Pedidos" Binding="{Binding ActiveOrders}" Width="85" />
                                    <DataGridTextColumn Header="Desde" Binding="{Binding StartedDisplay}" Width="155" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reabrir pedido" x:Name="ReopenTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="ReopenGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="ReopenGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="190" />
                            <DataGridTextColumn Header="Mesa" Binding="{Binding TableName}" Width="130" />
                            <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="105" />
                            <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatus}" Width="120" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="110" />
                            <DataGridCheckBoxColumn Header="Permitido" Binding="{Binding Eligible}" Width="80" />
                            <DataGridTextColumn Header="Bloqueio" Binding="{Binding BlockReason}" Width="*" />
                            <DataGridTextColumn Header="Atualizado" Binding="{Binding UpdatedDisplay}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ReopenReasonBox" Height="42" VerticalContentAlignment="Center" MaxLength="300" ToolTip="Motivo obrigatório da reabertura" />
                        <Button x:Name="ReopenButton" Grid.Column="1" Content="Reabrir pedido" IsEnabled="False" Click="ReopenButton_Click" Margin="12,0,0,0" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatusText" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820" />
            <Button Content="Fechar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="CloseButton_Click" Margin="0" />
        </Grid>
    </Grid>
</Window>