{
  "name": "eventmenu/premium",
  "description": "EventMenu Premium - eventos, cardápio, delivery e pagamentos multiempresa",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-openssl": "*",
    "stripe/stripe-php": "^18.0",
    "mercadopago/dx-php": "^3.8",
    "endroid/qr-code": "^6.0"
  },
  "autoload": {
    "psr-4": {
