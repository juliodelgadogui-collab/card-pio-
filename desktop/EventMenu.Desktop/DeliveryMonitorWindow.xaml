<Window x:Class="EventMenu.Desktop.DeliveryMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entregas ao vivo • EventMenu" Width="1180" Height="700"
        MinWidth="940" MinHeight="580" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Entregas ao vivo" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Acompanhe as entregas em rota e abra o mapa somente quando precisar." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Atualizar agora" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="RefreshButton_Click" Margin="0" MinWidth="118" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="White" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Text="Carregando entregas..." FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="A posição é exibida somente enquanto o entregador está em rota." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="DeliveriesGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DeliveriesGrid_SelectionChanged"
                      RowHeight="44" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Entregador" Binding="{Binding DeliveryName}" Width="175" />
                    <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="85" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="165" />
                    <DataGridTextColumn Header="Destino" Binding="{Binding DeliveryAddress}" Width="*" MinWidth="260" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding OnlineLabel}" Width="125" />
                    <DataGridTextColumn Header="Última atualização" Binding="{Binding RecordedAt}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="2,0,18,0">
                    <TextBlock Text="Entrega selecionada" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="DetailText" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MapButton" Content="Abrir no mapa" IsEnabled="False" Click="MapButton_Click" MinWidth="122" />
                    <Button x:Name="CopyButton" Content="Copiar posição" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CopyButton_Click" MinWidth="112" />
                    <Button Content="Fechar" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0" MinWidth="82" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
